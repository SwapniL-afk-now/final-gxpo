     def compute_logits(
         self,
         hidden_states: torch.Tensor,
     ) -> torch.Tensor | None:
+        if self.sled_enabled:
+            hidden_size = self.config.hidden_size
+            expected_width = (1 + len(self.model.sled_early_layers)) * hidden_size
+            if hidden_states.shape[-1] != expected_width:
+                raise RuntimeError("SLED hidden-state width does not match configured layers")
+            hidden_parts = hidden_states.split(hidden_size, dim=-1)
+            final_hidden_states, early_hidden_states = hidden_parts[0], hidden_parts[1:]
+            final_logits = self.logits_processor(self.lm_head, final_hidden_states)
+            if final_logits is None:
+                return None
+            early_hidden_states = torch.stack(
+                [self.model.norm(early) for early in early_hidden_states], dim=0
+            )
+            early_logits = self.logits_processor(
+                self.lm_head, early_hidden_states.reshape(-1, hidden_size)
+            )
+            if early_logits is None:
+                return None
+            early_logits = early_logits.reshape(
+                len(early_hidden_states), final_logits.shape[0], final_logits.shape[-1]
+            ).float()
+            final_logits = final_logits.float()
+
+            # Paper SLED: use aligned early-layer directions to modify only
+            # final-layer top-k tokens, then let vLLM perform normal sampling.
+            k = min(self.sled_scale, final_logits.shape[-1])
+            _, topk_indices = torch.softmax(final_logits, dim=-1).topk(k, dim=-1)
+            early_probs = torch.softmax(early_logits, dim=-1)
+            divergence = early_logits - final_logits.unsqueeze(0)
+            dot = (early_probs * divergence).sum(dim=-1, keepdim=True)
+            divergence_norm = divergence.square().sum(dim=-1, keepdim=True).sqrt().clamp_min(1e-12)
+            early_topk_probs = early_probs.gather(
+                -1, topk_indices.unsqueeze(0).expand(early_probs.shape[0], -1, -1)
+            )
+            divergence_topk = divergence.gather(
+                -1, topk_indices.unsqueeze(0).expand(early_logits.shape[0], -1, -1)
+            )
+            direction_norm = (
+                early_probs.square().sum(dim=-1, keepdim=True) + 1
+                - 2 * early_topk_probs
+            ).clamp_min(1e-12).sqrt()
+            cosine = (dot - divergence_topk) / (divergence_norm * direction_norm)
+            selected_values, selected_positions = cosine.topk(k, dim=-1)
+            selected_values = selected_values.clamp_min(0).square()
+            layer_mass = selected_values.sum(dim=-1, keepdim=True)
+            selected_values = selected_values / layer_mass.clamp_min(1e-12)
+            layer_weights = layer_mass.squeeze(-1)
+            layer_weights = layer_weights / layer_weights.sum(dim=0, keepdim=True).clamp_min(1e-12)
+            selected_tokens = topk_indices.unsqueeze(0).expand(early_logits.shape[0], -1, -1).gather(
+                -1, selected_positions
+            )
+            delta = torch.zeros_like(final_logits)
+            for layer in range(selected_tokens.shape[0]):
+                delta.scatter_add_(
+                    -1, selected_tokens[layer],
+                    -(selected_values[layer] * layer_weights[layer].unsqueeze(-1)),
+                )
+            evolved = final_logits - self.sled_alpha * (torch.softmax(final_logits, dim=-1) + delta)
+            output = torch.full_like(evolved, self.sled_lower_bound)
+            output.scatter_(-1, topk_indices, evolved.gather(-1, topk_indices))
+            return output
